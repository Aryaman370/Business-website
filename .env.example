# Server Configuration
PORT=3000
NODE_ENV=development

# Email Service Configuration
# Choose one: gmail, sendgrid, mailgun, or leave empty for console logging (development)
EMAIL_SERVICE=gmail

# === Option 1: Gmail (Recommended for small projects) ===
# Generate App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=aryamaninbox@gmail.com
GMAIL_APP_PASSWORD=zzjjpgfefklssjmn

# === Option 2: SendGrid (Recommended for production) ===
# Get API key at: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_SENDER=noreply@yourdomain.com

# === Option 3: Mailgun (Alternative for production) ===
# Get API key at: https://app.mailgun.com/app/account/security/api_keys
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_DOMAIN=mg.yourdomain.com

# CORS Configuration (optional)
# CORS_ORIGIN=http://localhost:8000

# Rate Limiting (optional, defaults shown)
# RATE_LIMIT_WINDOW=60000
# MAX_REQUESTS_PER_WINDOW=3
